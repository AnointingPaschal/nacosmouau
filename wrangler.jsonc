{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nacos-mouau-platform",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-11-19",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nacos-mouau",
      "database_id": "51c7fdd7-e6d0-4269-8e0b-d0cf2fe68f38",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "nacos-mouau-media" }
  ],
  "vars": {
    "APP_URL": "https://nacos-mouau-platform.pages.dev",
    "PAYSTACK_PUBLIC_KEY": "",
    "GITHUB_REPO": "AnointingPaschal/nacosmouau",
    "GITHUB_BRANCH": "main"
  }
}
